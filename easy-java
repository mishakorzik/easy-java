write_system_command() {
    local COMMAND_NAME="$1"
    local JAVA_ID="$2"
    local SLUG="$3"
    local TOOL="$4"
    local PATHNAME="$WRAPPER_DIR/$COMMAND_NAME"
    if [ -e "$PATHNAME" ] || [ -L "$PATHNAME" ]; then
        echo -e "\033[01;33mSkipping ${PATHNAME}: this command already exists.\033[0m"
        return 1
    fi
    local TMP STATUS=0
    TMP=$(mktemp) || return 1
    if [ "$IS_TERMUX" = true ]; then
        local INNER
        if [ -z "$SLUG" ]; then
            ensure_termux_java_selector "$JAVA_ID" || STATUS=1
            printf -v INNER 'java-%s; exec %s "$@"' "$JAVA_ID" "$TOOL"
        else
            printf -v INNER 'export JAVA_HOME=/usr/local/jdk-%s; export PATH="$JAVA_HOME/bin:/usr/local/%s/bin:$PATH"; exec %s "$@"' "$JAVA_ID" "$SLUG" "$TOOL"
        fi
        if [ "$STATUS" -eq 0 ]; then
            printf '#!%s/bin/bash\n' "$PREFIX" > "$TMP"
            printf 'echo -e "\\033[01;34m%s args\\033[0m: $*"\n' "$TOOL" >> "$TMP"
            printf 'unset LD_PRELOAD\n' >> "$TMP"
            # Binding the current directory makes -w "$PWD" valid even when the
            # command is started from $PREFIX/bin or another Android-only path.
            printf '%s' 'exec proot -0 --link2symlink -r "$PREFIX/../java" -b "$PWD" -w "$PWD" -b /dev/ -b /sys/ -b /proc/ -b "$HOME" /usr/bin/env -i HOME=/root TERM="${TERM:-xterm-256color}" PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash -ic ' >> "$TMP"
            printf "'%s' bash \"\$@\"\n" "$INNER" >> "$TMP"
            if ! mkdir -p "$WRAPPER_DIR" || ! install -m 0755 "$TMP" "$PATHNAME"; then
                STATUS=1
            fi
        fi
    else
        local JAVA_HOME_PATH="$BASE_DIR/jdk-${JAVA_ID}"
        local EXTRA_BIN=""
        if [ -n "$SLUG" ]; then
            EXTRA_BIN="$BASE_DIR/${SLUG}/bin"
        fi
        printf '#!/usr/bin/bash\n' > "$TMP"
        printf 'export JAVA_HOME=%q\n' "$JAVA_HOME_PATH" >> "$TMP"
        if [ -n "$EXTRA_BIN" ]; then
            printf 'export PATH="$JAVA_HOME/bin:%s:$PATH"\n' "$EXTRA_BIN" >> "$TMP"
        else
            printf 'export PATH="$JAVA_HOME/bin:$PATH"\n' >> "$TMP"
        fi
        printf 'echo -e "\\033[01;34m%s args\\033[0m: $*"\n' "$TOOL" >> "$TMP"
        printf 'exec %q "$@"\n' "$TOOL" >> "$TMP"
        if ! run_as_root mkdir -p "$WRAPPER_DIR" ||
           ! run_as_root install -m 0755 "$TMP" "$PATHNAME"; then
            STATUS=1
        fi
    fi
    rm -f "$TMP"
    return "$STATUS"
}
write_managed_rc_block() {
    local OWNER="$1"
    local JAVA_ID="$2"
    local SLUG="$3"
    shift 3
    local TOOLS=("$@")
    local RC
    RC=$(get_rc_file)
    mkdir -p "$(dirname "$RC")" || return 1
    touch "$RC" || return 1
    if [ "$IS_TERMUX" = true ] && [ -z "$SLUG" ]; then
        ensure_termux_java_selector "$JAVA_ID" || return 1
    fi
    local TMP
    TMP=$(mktemp) || return 1
    printf '# >>> easy-java:%s >>>\n' "$OWNER" > "$TMP"
    local TOOL COMMAND_NAME
    for TOOL in "${TOOLS[@]}"; do
        COMMAND_NAME="${TOOL}-${JAVA_ID}"
        printf '%s() {\n' "$COMMAND_NAME" >> "$TMP"
        printf '  echo -e "\\033[01;34m%s args\\033[0m: $*"\n' "$TOOL" >> "$TMP"
        if [ "$IS_TERMUX" = true ]; then
            local INNER
            if [ -z "$SLUG" ]; then
                printf -v INNER 'java-%s; exec %s "$@"' "$JAVA_ID" "$TOOL"
            else
                printf -v INNER 'export JAVA_HOME=/usr/local/jdk-%s; export PATH="$JAVA_HOME/bin:/usr/local/%s/bin:$PATH"; exec %s "$@"' \
                    "$JAVA_ID" "$SLUG" "$TOOL"
            fi
            printf '  unset LD_PRELOAD\n' >> "$TMP"
            printf '%s' '  proot -0 --link2symlink -r "$PREFIX/../java" -b "$PWD" -w "$PWD" -b /dev/ -b /sys/ -b /proc/ -b "$HOME" /usr/bin/env -i HOME=/root TERM="${TERM:-xterm-256color}" PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash -ic ' >> "$TMP"
            printf "'%s' bash \"\$@\"\n" "$INNER" >> "$TMP"
        else
            local JAVA_HOME_PATH="$BASE_DIR/jdk-${JAVA_ID}"
            local EXTRA_BIN=""
            if [ -n "$SLUG" ]; then
                EXTRA_BIN="$BASE_DIR/${SLUG}/bin"
            fi
            printf '  export JAVA_HOME=%q\n' "$JAVA_HOME_PATH" >> "$TMP"
            if [ -n "$EXTRA_BIN" ]; then
                printf '  export PATH="$JAVA_HOME/bin:%s:$PATH"\n' "$EXTRA_BIN" >> "$TMP"
            else
                printf '  export PATH="$JAVA_HOME/bin:$PATH"\n' >> "$TMP"
            fi
            printf '  command %q "$@"\n' "$TOOL" >> "$TMP"
        fi
        printf '}\n' >> "$TMP"
    done
    printf '# <<< easy-java:%s <<<\n' "$OWNER" >> "$TMP"
    local STATUS=0
    cat "$TMP" >> "$RC" || STATUS=$?
    rm -f "$TMP"
    return "$STATUS"
}
register_tool_integration() {
    local OWNER="$1"
    local JAVA_ID="$2"
    local SLUG="$3"
    local METHOD="$4"
    shift 4
    local RAW_TOOLS=("$@")
    local TOOLS=()
    local COMMANDS=()
    local CREATED_SYSTEM_COMMANDS=()
    local TOOL COMMAND_NAME
    for TOOL in "${RAW_TOOLS[@]}"; do
        if is_supported_tool_name "$TOOL"; then
            TOOLS+=("$TOOL")
            COMMANDS+=("${TOOL}-${JAVA_ID}")
        else
            echo -e "\033[01;33mSkipping unsupported executable name: ${TOOL}\033[0m"
        fi
    done
    if [ ${#TOOLS[@]} -eq 0 ]; then
        echo -e "\033[01;31mNo executable tools were found to register.\033[0m"
        return 1
    fi
    mapfile -t TOOLS < <(printf '%s\n' "${TOOLS[@]}" | awk 'NF && !seen[$0]++')
    COMMANDS=()
    for TOOL in "${TOOLS[@]}"; do
        COMMANDS+=("${TOOL}-${JAVA_ID}")
    done
    remove_integration_owner "$OWNER" "${COMMANDS[@]}"
    case "$METHOD" in
        1)
            write_managed_rc_block "$OWNER" "$JAVA_ID" "$SLUG" "${TOOLS[@]}" || return 1
            ;;
        2)
            for TOOL in "${TOOLS[@]}"; do
                COMMAND_NAME="${TOOL}-${JAVA_ID}"
                if write_system_command "$COMMAND_NAME" "$JAVA_ID" "$SLUG" "$TOOL"; then
                    CREATED_SYSTEM_COMMANDS+=("$COMMAND_NAME")
                fi
            done
            if [ ${#CREATED_SYSTEM_COMMANDS[@]} -eq 0 ]; then
                echo -e "\033[01;31mNo system commands were created.\033[0m"
                return 1
            fi
            COMMANDS=("${CREATED_SYSTEM_COMMANDS[@]}")
            ;;
        *)
            return 1
            ;;
    esac
    save_integration_manifest "$OWNER" "${COMMANDS[@]}" || return 1
    if [ "$METHOD" = "2" ]; then
        save_system_command_manifest "$OWNER" "${CREATED_SYSTEM_COMMANDS[@]}" || return 1
    fi

    local EXAMPLE="${COMMANDS[0]}"
    case "$METHOD" in
        1) echo -e "\033[01;32mAdded ${#COMMANDS[@]} commands\033[0m to $(get_rc_file). Example: ${EXAMPLE}" ;;
        2) echo -e "\033[01;32mAdded ${#CREATED_SYSTEM_COMMANDS[@]} commands\033[0m to ${WRAPPER_DIR}. Example: ${EXAMPLE}" ;;
    esac
}
prompt_integration_method() {
    SELECTED_INTEGRATION_METHOD=""
    echo -e "How should the commands be added?"
    echo -e "\033[01;34m01\033[0m. Shell functions in $(get_rc_file)"
    echo -e "\033[01;34m02\033[0m. Simple executable commands in ${WRAPPER_DIR}"
    echo -e "\033[01;34m00\033[0m. Do not add commands"
    local CHOICE
    read_menu_choice CHOICE
    case "$CHOICE" in
        1) SELECTED_INTEGRATION_METHOD=1 ;;
        2) SELECTED_INTEGRATION_METHOD=2 ;;
