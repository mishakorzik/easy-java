#!/usr/bin/bash

VERSION="2.0.0"
check_update() {
    local REMOTE
    REMOTE=$(wget -qO- "https://raw.githubusercontent.com/mishakorzik/easy-java/refs/heads/main/version.txt" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$REMOTE" ]; then
        echo -e "\033[01;33mCould not check for updates (no internet or URL unavailable).\033[0m"
        return
    fi
    if [ "$REMOTE" != "$VERSION" ]; then
        echo -e "\033[01;31mA new version is available: ${REMOTE} (you have ${VERSION})\033[0m"
        echo -e "\033[01;33mPlease update from: https://github.com/mishakorzik/easy-java\033[0m"
        exit 0
    fi
}
if [ -d "$PREFIX" ] && [ "$PREFIX" = "/data/data/com.termux/files/usr" ]; then
    IS_TERMUX=true
    BASE_DIR="/data/data/com.termux/files/java/usr/local"
    CONTAINER_ROOT="/data/data/com.termux/files/java"
else
    IS_TERMUX=false
    BASE_DIR="/usr/local"
    CONTAINER_ROOT=""
fi
if [ "$(uname -m)" != "aarch64" ]; then
    echo "This system is not arm64 architecture."
    exit 1
fi
if [ "$IS_TERMUX" = false ]; then
    if ! grep -q "ID=debian" /etc/os-release && ! grep -q "ID=ubuntu" /etc/os-release; then
        echo "This system is not supported. Supported systems: debian, ubuntu, termux."
        exit 1
    fi
fi
if [ "$IS_TERMUX" = true ]; then
    command -v proot &>/dev/null && echo -e "proot is \033[01;32minstalled\033[0m" || { echo -e "proot is \033[01;31mnot\033[0m installed"; pkg install proot -y; }
    command -v debootstrap &>/dev/null && echo -e "debootstrap is \033[01;32minstalled\033[0m" || { echo -e "debootstrap is \033[01;31mnot\033[0m installed"; pkg install debootstrap -y; }
    command -v gdown &>/dev/null && echo -e "gdown is \033[01;32minstalled\033[0m" || { echo -e "gdown is \033[01;31mnot\033[0m installed"; python3 -m pip install gdown; }
    command -v tar &>/dev/null && echo -e "tar is \033[01;32minstalled\033[0m" || { echo -e "tar is \033[01;31mnot\033[0m installed"; pkg install tar -y; }
    command -v wget &>/dev/null && echo -e "wget is \033[01;32minstalled\033[0m" || { echo -e "wget is \033[01;31mnot\033[0m installed"; pkg install wget -y; }
    command -v unzip &>/dev/null && echo -e "unzip is \033[01;32minstalled\033[0m" || { echo -e "unzip is \033[01;31mnot\033[0m installed"; pkg install unzip -y; }
else
    command -v tar &>/dev/null && echo -e "tar is \033[01;32minstalled\033[0m" || { echo -e "tar is \033[01;31mnot\033[0m installed"; sudo apt install tar -y; }
    command -v wget &>/dev/null && echo -e "wget is \033[01;32minstalled\033[0m" || { echo -e "wget is \033[01;31mnot\033[0m installed"; sudo apt install wget -y; }
    command -v unzip &>/dev/null && echo -e "unzip is \033[01;32minstalled\033[0m" || { echo -e "unzip is \033[01;31mnot\033[0m installed"; sudo apt install unzip -y; }
    command -v gdown &>/dev/null && echo -e "gdown is \033[01;32minstalled\033[0m" || { echo -e "gdown is \033[01;31mnot\033[0m installed"; sudo python3 -m pip install gdown; }
fi
check_update

JAVA_VERSIONS=(22 21 20 19 17 16 15 11 8)
declare -A JAVA_GDRIVE=(
    [22]="1jGXGcSepZkt5bKVWHyYAzJCzSXAijItu"
    [21]="1yyRpoeL5ITOJb4K_mIHS9gCDtiY2TVLz"
    [20]="17V6Y7khQZvt2dIvaqpI5cjVmtrQvpaQo"
    [19]="1_lEitg91FWm4emuD1uamA7arl69MALEX"
    [17]="1CzwHZMl7qyjIhB1E7m8xbKyxeOqQ8Fq1"
    [16]="1xGNogkxQ22c9BGtvrK8gkWGqyvGfSr3s"
    [15]="1FLtZKNmN0h_wSVlDRBYb6hC-vgQuZ2UE"
    [11]="1P0luM8WZEMLFbCPDWjYIp27qytXLC9Sc"
    [8]="1Ey0L6dnTsuEvDNYoexc8cRbtGWANrmbL")

MAVEN_VERSIONS=("3.9.14" "3.8.9")
declare -A MAVEN_URLS=(
    ["3.9.14"]="https://dlcdn.apache.org/maven/maven-3/3.9.14/binaries/apache-maven-3.9.14-bin.tar.gz"
    ["3.8.9"]="https://dlcdn.apache.org/maven/maven-3/3.8.9/binaries/apache-maven-3.8.9-bin.tar.gz")

GRADLE_VERSIONS=("9.4.1" "9.4.0" "9.3.1" "8.14.4" "8.14.3" "7.6.6")
declare -A GRADLE_URLS=(
    ["9.4.1"]="https://services.gradle.org/distributions/gradle-9.4.1-bin.zip"
    ["9.4.0"]="https://services.gradle.org/distributions/gradle-9.4.0-bin.zip"
    ["9.3.1"]="https://services.gradle.org/distributions/gradle-9.3.1-bin.zip"
    ["8.14.4"]="https://services.gradle.org/distributions/gradle-8.14.4-bin.zip"
    ["8.14.3"]="https://services.gradle.org/distributions/gradle-8.14.3-bin.zip"
    ["7.6.6"]="https://services.gradle.org/distributions/gradle-7.6.6-bin.zip")

get_jdk_dir() { [ "$1" = "8" ] && echo "jdk1.8.0" || echo "jdk-$1"; }
get_rc_file() {
    if [ -d "$HOME/.oh-my-zsh" ]; then
        echo "$HOME/.zshrc"
    elif [ "$IS_TERMUX" = true ]; then
        echo "$PREFIX/etc/bash.bashrc"
    else
        echo "$HOME/.bashrc"
    fi
}
is_java_installed() { [ -d "$BASE_DIR/$(get_jdk_dir "$1")" ]; }
get_installed_javas() {
    local arr=()
    for v in "${JAVA_VERSIONS[@]}"; do
        is_java_installed "$v" && arr+=("$v")
    done
    echo "${arr[@]}"
}
is_maven_installed() { [ -d "$BASE_DIR/mvn" ]; }
get_maven_version() { [ -f "$BASE_DIR/mvn/.version" ] && cat "$BASE_DIR/mvn/.version" || echo ""; }
is_gradle_version_installed() { [ -d "$BASE_DIR/gradle-$1" ]; }
escape_ver() { echo "${1//./\\.}"; }
ensure_container() {
    [ "$IS_TERMUX" = false ] && return
    if [ -d "$CONTAINER_ROOT" ]; then
        echo "Skipping Debian container install (already exists)"
        return
    fi
    echo "Installing Debian container (this will take a while)..."
    debootstrap --variant=minbase --arch=arm64 --components=main stable "$CONTAINER_ROOT" http://ftp.debian.org/debian/ > /dev/null 2>&1
    echo "Verifying Debian container..."
    unset LD_PRELOAD
    if proot -0 --link2symlink -r "$CONTAINER_ROOT" -w /root \
        -b /dev/ -b /sys/ -b /proc/ \
        -b /data/data/com.termux/files/home \
        /usr/bin/env -i HOME=/root TERM="xterm-256color" \
        PATH=/bin:/usr/bin:/sbin:/usr/sbin \
        grep -q "ID=debian" /etc/os-release; then
        echo -e "Debian container \033[01;32minstalled\033[0m"
    else
        rm -rf "$CONTAINER_ROOT"
        echo -e "\033[01;31mFailed to install Debian container\033[0m"
        exit 1
    fi
}
remove_java_from_rc() {
    local VER="$1"
    local RC
    RC=$(get_rc_file)
    sed -i "/^java-${VER}() {/,/^}/d" "$RC" 2>/dev/null
    sed -i "/^javac-${VER}() {/,/^}/d" "$RC" 2>/dev/null
    sed -i "/^mvn-${VER}() {/,/^}/d" "$RC" 2>/dev/null
    [ "$IS_TERMUX" = true ] && sed -i "/alias java-${VER}=/d" "$CONTAINER_ROOT/root/.bashrc" 2>/dev/null
}
remove_java_alias_from_rc() {
    local VER="$1"
    local RC
    RC=$(get_rc_file)
    sed -i "/^java-${VER}() {/,/^}/d" "$RC" 2>/dev/null
    sed -i "/^javac-${VER}() {/,/^}/d" "$RC" 2>/dev/null
    [ "$IS_TERMUX" = true ] && sed -i "/alias java-${VER}=/d" "$CONTAINER_ROOT/root/.bashrc" 2>/dev/null
}
remove_mvn_java_from_rc() {
    local JAVA_VER="$1"
    local RC
    RC=$(get_rc_file)
    sed -i "/^mvn-${JAVA_VER}() {/,/^}/d" "$RC" 2>/dev/null
}
remove_all_mvn_from_rc() {
    local RC
    RC=$(get_rc_file)
    for v in "${JAVA_VERSIONS[@]}"; do
        sed -i "/^mvn-${v}() {/,/^}/d" "$RC" 2>/dev/null
    done
}
remove_gradle_from_rc() {
    local GVER="$1"
    local RC
    RC=$(get_rc_file)
    local EV
    EV=$(escape_ver "$GVER")
    sed -i "/^gradle-${EV}() {/,/^}/d" "$RC" 2>/dev/null
}
remove_all_gradle_from_rc() {
    local RC
    RC=$(get_rc_file)
    for gv in "${GRADLE_VERSIONS[@]}"; do
        local EV
        EV=$(escape_ver "$gv")
        sed -i "/^gradle-${EV}() {/,/^}/d" "$RC" 2>/dev/null
    done
}
register_java_functions() {
    local VER="$1"
    local JDK
    JDK=$(get_jdk_dir "$VER")
    local RC
    RC=$(get_rc_file)
    grep -q "^java-${VER}() {" "$RC" 2>/dev/null && return
    if [ "$IS_TERMUX" = true ]; then
        echo "java-${VER}() {" >> "$RC"
        echo '  echo -e "\033[01;34mjava args\033[0m: $*"; unset LD_PRELOAD; proot -0 --link2symlink -r $PREFIX/../java -w "$PWD" -b /dev/ -b /sys/ -b /proc/ -b /data/data/com.termux/files/home /usr/bin/env -i HOME=/root TERM="xterm-256color" PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash -ic "java-'"${VER}"'; java $*"' >> "$RC"
        echo "}" >> "$RC"
        echo "javac-${VER}() {" >> "$RC"
        echo '  echo -e "\033[01;34mjavac args\033[0m: $*"; unset LD_PRELOAD; proot -0 --link2symlink -r $PREFIX/../java -w "$PWD" -b /dev/ -b /sys/ -b /proc/ -b /data/data/com.termux/files/home /usr/bin/env -i HOME=/root TERM="xterm-256color" PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash -ic "java-'"${VER}"'; javac $*"' >> "$RC"
        echo "}" >> "$RC"
    else
        echo "java-${VER}() {" >> "$RC"
        echo "  echo -e \"\033[01;34mjava args\033[0m: \$*\"; export PATH=/usr/local/${JDK}/bin:\$PATH; java \"\$@\"" >> "$RC"
        echo "}" >> "$RC"
        echo "javac-${VER}() {" >> "$RC"
        echo "  echo -e \"\033[01;34mjavac args\033[0m: \$*\"; export PATH=/usr/local/${JDK}/bin:\$PATH; javac \"\$@\"" >> "$RC"
        echo "}" >> "$RC"
    fi
}
readd_java_alias() {
    local VER="$1"
    local JDK
    JDK=$(get_jdk_dir "$VER")
    remove_java_alias_from_rc "$VER"
    local RC
    RC=$(get_rc_file)
    if [ "$IS_TERMUX" = true ]; then
        echo "java-${VER}() {" >> "$RC"
        echo '  echo -e "\033[01;34mjava args\033[0m: $*"; unset LD_PRELOAD; proot -0 --link2symlink -r $PREFIX/../java -w "$PWD" -b /dev/ -b /sys/ -b /proc/ -b /data/data/com.termux/files/home /usr/bin/env -i HOME=/root TERM="xterm-256color" PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash -ic "java-'"${VER}"'; java $*"' >> "$RC"
        echo "}" >> "$RC"
        echo "javac-${VER}() {" >> "$RC"
        echo '  echo -e "\033[01;34mjavac args\033[0m: $*"; unset LD_PRELOAD; proot -0 --link2symlink -r $PREFIX/../java -w "$PWD" -b /dev/ -b /sys/ -b /proc/ -b /data/data/com.termux/files/home /usr/bin/env -i HOME=/root TERM="xterm-256color" PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash -ic "java-'"${VER}"'; javac $*"' >> "$RC"
        echo "}" >> "$RC"
        sed -i "/alias java-${VER}=/d" "$CONTAINER_ROOT/root/.bashrc" 2>/dev/null
        echo "alias java-${VER}=\"export PATH=/usr/local/${JDK}/bin:\$PATH\"" >> "$CONTAINER_ROOT/root/.bashrc"
    else
        echo "java-${VER}() {" >> "$RC"
        echo "  echo -e \"\033[01;34mjava args\033[0m: \$*\"; export PATH=/usr/local/${JDK}/bin:\$PATH; java \"\$@\"" >> "$RC"
        echo "}" >> "$RC"
        echo "javac-${VER}() {" >> "$RC"
        echo "  echo -e \"\033[01;34mjavac args\033[0m: \$*\"; export PATH=/usr/local/${JDK}/bin:\$PATH; javac \"\$@\"" >> "$RC"
        echo "}" >> "$RC"
    fi
    echo -e "Alias java-${VER} / javac-${VER} \033[01;32mre-added\033[0m"
}
register_mvn_function() {
    local JAVA_VER="$1"
    local JDK
    JDK=$(get_jdk_dir "$JAVA_VER")
    local RC
    RC=$(get_rc_file)
    remove_mvn_java_from_rc "$JAVA_VER"
    if [ "$IS_TERMUX" = true ]; then
        echo "mvn-${JAVA_VER}() {" >> "$RC"
        echo '  echo -e "\033[01;34mmvn args\033[0m: $*"; unset LD_PRELOAD; proot -0 --link2symlink -r $PREFIX/../java -w "$PWD" -b /dev/ -b /sys/ -b /proc/ -b /data/data/com.termux/files/home /usr/bin/env -i HOME=/root TERM="xterm-256color" PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash -ic "java-'"${JAVA_VER}"'; /usr/local/mvn/bin/mvn $*"' >> "$RC"
        echo "}" >> "$RC"
    else
        echo "mvn-${JAVA_VER}() {" >> "$RC"
        echo "  echo -e \"\033[01;34mmvn args\033[0m: \$*\"; export PATH=/usr/local/${JDK}/bin:\$PATH; /usr/local/mvn/bin/mvn \"\$@\"" >> "$RC"
        echo "}" >> "$RC"
    fi
    echo -e "mvn-${JAVA_VER} \033[01;32madded\033[0m"
}
register_gradle_function() {
    local JAVA_VER="$1"
    local GVER="$2"
    local JDK
    JDK=$(get_jdk_dir "$JAVA_VER")
    local RC
    RC=$(get_rc_file)
    remove_gradle_from_rc "$GVER"
    if [ "$IS_TERMUX" = true ]; then
        echo "gradle-${GVER}() {" >> "$RC"
        echo '  echo -e "\033[01;34mgradle args\033[0m: $*"; unset LD_PRELOAD; proot -0 --link2symlink -r $PREFIX/../java -w "$PWD" -b /dev/ -b /sys/ -b /proc/ -b /data/data/com.termux/files/home /usr/bin/env -i HOME=/root TERM="xterm-256color" PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash -ic "java-'"${JAVA_VER}"'; /usr/local/gradle-'"${GVER}"'/bin/gradle $*"' >> "$RC"
        echo "}" >> "$RC"
    else
        echo "gradle-${GVER}() {" >> "$RC"
        echo "  echo -e \"\033[01;34mgradle args\033[0m: \$*\"; export PATH=/usr/local/${JDK}/bin:\$PATH; /usr/local/gradle-${GVER}/bin/gradle \"\$@\"" >> "$RC"
        echo "}" >> "$RC"
    fi
    echo -e "gradle-${GVER} \033[01;32madded\033[0m"
}
do_install_java() {
    local VER="$1"
    local JDK
    JDK=$(get_jdk_dir "$VER")
    local ARCHIVE="jdk-${VER}-latest-aarch64_bin.tar.gz"
    ensure_container
    cd "$BASE_DIR" || exit 1
    rm -rf "$JDK"
    echo "Downloading Oracle Java ${VER}..."
    if [ "$IS_TERMUX" = true ]; then
        gdown "${JAVA_GDRIVE[$VER]}"
        echo "Extracting Oracle Java ${VER}..."
        tar -xf "$ARCHIVE"
        rm "$ARCHIVE"
        sed -i "/alias java-${VER}=/d" "$CONTAINER_ROOT/root/.bashrc" 2>/dev/null
        echo "alias java-${VER}=\"export PATH=/usr/local/${JDK}/bin:\$PATH\"" >> "$CONTAINER_ROOT/root/.bashrc"
    else
        sudo gdown "${JAVA_GDRIVE[$VER]}"
        echo "Extracting Oracle Java ${VER}..."
        sudo tar -xf "$ARCHIVE"
        sudo rm "$ARCHIVE"
    fi
}
do_remove_java() {
    local VER="$1"
    local JDK
    JDK=$(get_jdk_dir "$VER")
    echo "Removing Oracle Java ${VER}..."
    if [ "$IS_TERMUX" = true ]; then
        rm -rf "$BASE_DIR/$JDK"
    else
        sudo rm -rf "$BASE_DIR/$JDK"
    fi
    remove_java_from_rc "$VER"
    echo -e "Java ${VER} \033[01;32mremoved\033[0m"
}
do_install_maven() {
    local MVER="$1"
    local URL="${MAVEN_URLS[$MVER]}"
    local ARCHIVE="apache-maven-${MVER}-bin.tar.gz"
    ensure_container
    cd "$BASE_DIR" || exit 1
    echo "Downloading Apache Maven ${MVER}..."
    if [ "$IS_TERMUX" = true ]; then
        rm -rf mvn
        mkdir -p mvn
        wget -q "$URL" -O "$ARCHIVE"
        echo "Extracting Apache Maven ${MVER}..."
        tar -xf "$ARCHIVE" --strip-components=1 -C mvn
        rm "$ARCHIVE"
        echo "$MVER" > mvn/.version
    else
        sudo rm -rf mvn
        sudo mkdir -p mvn
        sudo wget -q "$URL" -O "$ARCHIVE"
        echo "Extracting Apache Maven ${MVER}..."
        sudo tar -xf "$ARCHIVE" --strip-components=1 -C mvn
        sudo rm "$ARCHIVE"
        echo "$MVER" | sudo tee mvn/.version > /dev/null
    fi
    echo -e "Maven ${MVER} \033[01;32minstalled\033[0m"
}
do_remove_maven() {
    echo "Removing Maven..."
    if [ "$IS_TERMUX" = true ]; then
        rm -rf "$BASE_DIR/mvn"
    else
        sudo rm -rf "$BASE_DIR/mvn"
    fi
    remove_all_mvn_from_rc
    echo -e "Maven \033[01;32mremoved\033[0m"
}
do_install_gradle() {
    local GVER="$1"
    local URL="${GRADLE_URLS[$GVER]}"
    local ARCHIVE="gradle-${GVER}-bin.zip"
    ensure_container
    cd "$BASE_DIR" || exit 1
    echo "Downloading Gradle ${GVER}..."
    if [ "$IS_TERMUX" = true ]; then
        rm -rf "gradle-${GVER}"
        wget -q "$URL" -O "$ARCHIVE"
        echo "Extracting Gradle ${GVER}..."
        unzip -q "$ARCHIVE"
        rm "$ARCHIVE"
    else
        sudo rm -rf "gradle-${GVER}"
        sudo wget -q "$URL" -O "$ARCHIVE"
        echo "Extracting Gradle ${GVER}..."
        sudo unzip -q "$ARCHIVE"
        sudo rm "$ARCHIVE"
    fi
    echo -e "Gradle ${GVER} \033[01;32minstalled\033[0m"
}
do_remove_gradle() {
    local GVER="$1"
    echo "Removing Gradle ${GVER}..."
    if [ "$IS_TERMUX" = true ]; then
        rm -rf "$BASE_DIR/gradle-${GVER}"
    else
        sudo rm -rf "$BASE_DIR/gradle-${GVER}"
    fi
    remove_gradle_from_rc "$GVER"
    echo -e "Gradle ${GVER} \033[01;32mremoved\033[0m"
}
prompt_mvn_java_link() {
    local INSTALLED_ARR
    read -ra INSTALLED_ARR <<< "$(get_installed_javas)"
    if [ ${#INSTALLED_ARR[@]} -eq 0 ]; then
        echo "No Java versions installed. Install Java first."
        return
    fi
    echo -e ""
    echo -e "\033[01;33mSelect Java version to link with Maven:\033[0m"
    local RC
    RC=$(get_rc_file)
    for i in "${!INSTALLED_ARR[@]}"; do
        local JVER="${INSTALLED_ARR[$i]}"
        local ASTATUS=""
        grep -q "^mvn-${JVER}() {" "$RC" 2>/dev/null && ASTATUS=" \033[01;32m[alias exists]\033[0m"
        printf "  \033[01;34m%02d\033[0m. Java %s%b\n" "$((i+1))" "$JVER" "$ASTATUS"
    done
    printf "  \033[01;34m%02d\033[0m. Back\n" "$((${#INSTALLED_ARR[@]}+1))"
    read -p "Choose: " java_choice
    if [[ "$java_choice" =~ ^[0-9]+$ ]] && [ "$java_choice" -ge 1 ] && [ "$java_choice" -le "${#INSTALLED_ARR[@]}" ]; then
        local JAVA_VER="${INSTALLED_ARR[$((java_choice-1))]}"
        echo -e ""
        if grep -q "^mvn-${JAVA_VER}() {" "$RC" 2>/dev/null; then
            echo -e "\033[01;34m01\033[0m. Re-add alias mvn-${JAVA_VER}"
            echo -e "\033[01;34m02\033[0m. Delete alias mvn-${JAVA_VER}"
            echo -e "\033[01;34m03\033[0m. Back"
            read -p "Choose: " sub
            case "$sub" in
                1) register_mvn_function "$JAVA_VER" ;;
                2) remove_mvn_java_from_rc "$JAVA_VER"; echo -e "mvn-${JAVA_VER} \033[01;32mremoved\033[0m" ;;
            esac
        else
            echo -e "\033[01;34m01\033[0m. Add alias mvn-${JAVA_VER}"
            echo -e "\033[01;34m02\033[0m. Back"
            read -p "Choose: " sub
            [ "$sub" = "1" ] && register_mvn_function "$JAVA_VER"
        fi
    fi
}
prompt_gradle_java_link() {
    local GVER="$1"
    local INSTALLED_ARR
    read -ra INSTALLED_ARR <<< "$(get_installed_javas)"
    if [ ${#INSTALLED_ARR[@]} -eq 0 ]; then
        echo "No Java versions installed. Install Java first."
        return
    fi
    echo -e ""
    echo -e "\033[01;33mSelect Java version to link with Gradle ${GVER}:\033[0m"
    local RC
    RC=$(get_rc_file)
    local EV
    EV=$(escape_ver "$GVER")
    for i in "${!INSTALLED_ARR[@]}"; do
        local JVER="${INSTALLED_ARR[$i]}"
        local ASTATUS=""
        grep -q "^gradle-${EV}() {" "$RC" 2>/dev/null && ASTATUS=" \033[01;32m[alias exists]\033[0m"
        printf "  \033[01;34m%02d\033[0m. Java %s%b\n" "$((i+1))" "$JVER" "$ASTATUS"
    done
    printf "  \033[01;34m%02d\033[0m. Back\n" "$((${#INSTALLED_ARR[@]}+1))"
    read -p "Choose: " java_choice
    if [[ "$java_choice" =~ ^[0-9]+$ ]] && [ "$java_choice" -ge 1 ] && [ "$java_choice" -le "${#INSTALLED_ARR[@]}" ]; then
        local JAVA_VER="${INSTALLED_ARR[$((java_choice-1))]}"
        echo -e ""
        if grep -q "^gradle-${EV}() {" "$RC" 2>/dev/null; then
            echo -e "\033[01;34m01\033[0m. Re-add alias gradle-${GVER} (Java ${JAVA_VER})"
            echo -e "\033[01;34m02\033[0m. Delete alias gradle-${GVER}"
            echo -e "\033[01;34m03\033[0m. Back"
            read -p "Choose: " sub
            case "$sub" in
                1) register_gradle_function "$JAVA_VER" "$GVER" ;;
                2) remove_gradle_from_rc "$GVER"; echo -e "gradle-${GVER} \033[01;32mremoved\033[0m" ;;
            esac
        else
            echo -e "\033[01;34m01\033[0m. Add alias gradle-${GVER} (Java ${JAVA_VER})"
            echo -e "\033[01;34m02\033[0m. Back"
            read -p "Choose: " sub
            [ "$sub" = "1" ] && register_gradle_function "$JAVA_VER" "$GVER"
        fi
    fi
}
java_menu() {
    while true; do
        echo -e ""
        echo -e "\033[01;33mSelect Java version:\033[0m"
        for i in "${!JAVA_VERSIONS[@]}"; do
            local VER="${JAVA_VERSIONS[$i]}"
            local STATUS=""
            is_java_installed "$VER" && STATUS=" \033[01;32m[installed]\033[0m"
            printf "  \033[01;34m%02d\033[0m. Oracle Java %-3s%b\n" "$((i+1))" "$VER" "$STATUS"
        done
        printf "  \033[01;34m%02d\033[0m. Back\n" "$((${#JAVA_VERSIONS[@]}+1))"
        read -p "Choose: " choice
        local MAX="${#JAVA_VERSIONS[@]}"
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$MAX" ]; then
            local VER="${JAVA_VERSIONS[$((choice-1))]}"
            echo -e ""
            if is_java_installed "$VER"; then
                echo -e "\033[01;34m01\033[0m. Reinstall Java ${VER}"
                echo -e "\033[01;34m02\033[0m. Delete Java ${VER}"
                echo -e "\033[01;34m03\033[0m. Re-add alias"
                echo -e "\033[01;34m04\033[0m. Back"
                read -p "Choose: " sub
                case "$sub" in
                    1)
                        do_install_java "$VER"
                        echo -e "Java ${VER} \033[01;32mreinstalled\033[0m"
                        echo -e "To run: java-${VER}"
                        ;;
                    2)
                        do_remove_java "$VER"
                        ;;
                    3)
                        readd_java_alias "$VER"
                        echo -e "Restart shell to apply changes."
                        ;;
                esac
            else
                echo -e "\033[01;34m01\033[0m. Download Java ${VER}"
                echo -e "\033[01;34m02\033[0m. Back"
                read -p "Choose: " sub
                if [ "$sub" = "1" ]; then
                    do_install_java "$VER"
                    register_java_functions "$VER"
                    echo -e "Java ${VER} \033[01;32minstalled\033[0m"
                    echo -e "To run: java-${VER}"
                fi
            fi
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -eq "$((MAX+1))" ]; then
            break
        else
            echo "Invalid option"
        fi
    done
}
maven_menu() {
    local INSTALLED_CHECK
    read -ra INSTALLED_CHECK <<< "$(get_installed_javas)"
    if [ ${#INSTALLED_CHECK[@]} -eq 0 ] && ! is_maven_installed; then
        echo -e "\033[01;31mCannot install Maven: no Java version is installed. Install Java first.\033[0m"
        return
    fi
    while true; do
        echo -e ""
        echo -e "\033[01;33mMaven:\033[0m"
        local MVN_VER_INSTALLED
        MVN_VER_INSTALLED=$(get_maven_version)
        for i in "${!MAVEN_VERSIONS[@]}"; do
            local MVER="${MAVEN_VERSIONS[$i]}"
            local STATUS=""
            [ "$MVER" = "$MVN_VER_INSTALLED" ] && STATUS=" \033[01;32m[installed]\033[0m"
            printf "  \033[01;34m%02d\033[0m. Maven %-10s%b\n" "$((i+1))" "$MVER" "$STATUS"
        done
        local NEXT=$((${#MAVEN_VERSIONS[@]}+1))
        printf "  \033[01;34m%02d\033[0m. Manage aliases\n" "$NEXT"
        printf "  \033[01;34m%02d\033[0m. Back\n" "$((NEXT+1))"
        read -p "Choose: " choice
        local MAX="${#MAVEN_VERSIONS[@]}"
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$MAX" ]; then
            local MVER="${MAVEN_VERSIONS[$((choice-1))]}"
            echo -e ""
            if [ "$MVER" = "$MVN_VER_INSTALLED" ]; then
                echo -e "\033[01;34m01\033[0m. Reinstall Maven ${MVER}"
                echo -e "\033[01;34m02\033[0m. Delete Maven ${MVER}"
                echo -e "\033[01;34m03\033[0m. Re-add alias"
                echo -e "\033[01;34m04\033[0m. Back"
                read -p "Choose: " sub
                case "$sub" in
                    1) do_install_maven "$MVER"; prompt_mvn_java_link ;;
                    2) do_remove_maven ;;
                    3) prompt_mvn_java_link ;;
                esac
            else
                local INST_ARR
                read -ra INST_ARR <<< "$(get_installed_javas)"
                if [ ${#INST_ARR[@]} -eq 0 ]; then
                    echo -e "\033[01;31mCannot install Maven: no Java version is installed. Install Java first.\033[0m"
                else
                    echo -e "\033[01;34m01\033[0m. Download Maven ${MVER}"
                    echo -e "\033[01;34m02\033[0m. Back"
                    read -p "Choose: " sub
                    [ "$sub" = "1" ] && { do_install_maven "$MVER"; prompt_mvn_java_link; }
                fi
            fi
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -eq "$NEXT" ]; then
            if ! is_maven_installed; then
                echo "Maven is not installed. Install Maven first."
            else
                prompt_mvn_java_link
            fi
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -eq "$((NEXT+1))" ]; then
            break
        else
            echo "Invalid option"
        fi
    done
}
gradle_menu() {
    local INSTALLED_CHECK
    read -ra INSTALLED_CHECK <<< "$(get_installed_javas)"
    if [ ${#INSTALLED_CHECK[@]} -eq 0 ]; then
        local ANY_GRADLE=false
        for gv in "${GRADLE_VERSIONS[@]}"; do
            is_gradle_version_installed "$gv" && { ANY_GRADLE=true; break; }
        done
        if [ "$ANY_GRADLE" = false ]; then
            echo -e "\033[01;31mCannot install Gradle: no Java version is installed. Install Java first.\033[0m"
            return
        fi
    fi
    while true; do
        echo -e ""
        echo -e "\033[01;33mGradle:\033[0m"
        for i in "${!GRADLE_VERSIONS[@]}"; do
            local GVER="${GRADLE_VERSIONS[$i]}"
            local STATUS=""
            is_gradle_version_installed "$GVER" && STATUS=" \033[01;32m[installed]\033[0m"
            printf "  \033[01;34m%02d\033[0m. Gradle %-10s%b\n" "$((i+1))" "$GVER" "$STATUS"
        done
        local GNEXT=$((${#GRADLE_VERSIONS[@]}+1))
        printf "  \033[01;34m%02d\033[0m. Manage aliases\n" "$GNEXT"
        printf "  \033[01;34m%02d\033[0m. Back\n" "$((GNEXT+1))"
        read -p "Choose: " choice
        local MAX="${#GRADLE_VERSIONS[@]}"
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$MAX" ]; then
            local GVER="${GRADLE_VERSIONS[$((choice-1))]}"
            echo -e ""
            if is_gradle_version_installed "$GVER"; then
                echo -e "\033[01;34m01\033[0m. Reinstall Gradle ${GVER}"
                echo -e "\033[01;34m02\033[0m. Delete Gradle ${GVER}"
                echo -e "\033[01;34m03\033[0m. Re-add alias"
                echo -e "\033[01;34m04\033[0m. Back"
                read -p "Choose: " sub
                case "$sub" in
                    1) do_install_gradle "$GVER"; prompt_gradle_java_link "$GVER" ;;
                    2) do_remove_gradle "$GVER" ;;
                    3) prompt_gradle_java_link "$GVER" ;;
                esac
            else
                local INST_ARR
                read -ra INST_ARR <<< "$(get_installed_javas)"
                if [ ${#INST_ARR[@]} -eq 0 ]; then
                    echo -e "\033[01;31mCannot install Gradle: no Java version is installed. Install Java first.\033[0m"
                else
                    echo -e "\033[01;34m01\033[0m. Download Gradle ${GVER}"
                    echo -e "\033[01;34m02\033[0m. Back"
                    read -p "Choose: " sub
                    [ "$sub" = "1" ] && { do_install_gradle "$GVER"; prompt_gradle_java_link "$GVER"; }
                fi
            fi
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -eq "$GNEXT" ]; then
            local ANY_G=false
            for gv in "${GRADLE_VERSIONS[@]}"; do
                is_gradle_version_installed "$gv" && { ANY_G=true; break; }
            done
            if [ "$ANY_G" = false ]; then
                echo "No Gradle version is installed. Install Gradle first."
            else
                echo -e ""
                echo -e "\033[01;33mSelect installed Gradle to manage aliases:\033[0m"
                local INSTALLED_G=()
                for gv in "${GRADLE_VERSIONS[@]}"; do
                    is_gradle_version_installed "$gv" && INSTALLED_G+=("$gv")
                done
                local RC
                RC=$(get_rc_file)
                for i in "${!INSTALLED_G[@]}"; do
                    local GV="${INSTALLED_G[$i]}"
                    local EV
                    EV=$(escape_ver "$GV")
                    local ASTATUS=""
                    grep -q "^gradle-${EV}() {" "$RC" 2>/dev/null && ASTATUS=" \033[01;32m[alias exists]\033[0m"
                    printf "  \033[01;34m%02d\033[0m. Gradle %s%b\n" "$((i+1))" "$GV" "$ASTATUS"
                done
                printf "  \033[01;34m%02d\033[0m. Back\n" "$((${#INSTALLED_G[@]}+1))"
                read -p "Choose: " gchoice
                if [[ "$gchoice" =~ ^[0-9]+$ ]] && [ "$gchoice" -ge 1 ] && [ "$gchoice" -le "${#INSTALLED_G[@]}" ]; then
                    prompt_gradle_java_link "${INSTALLED_G[$((gchoice-1))]}"
                fi
            fi
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -eq "$((GNEXT+1))" ]; then
            break
        else
            echo "Invalid option"
        fi
    done
}
manual_launch() {
    ensure_container
    echo -e "Launching \033[01;34mproot shell\033[0m..."
    unset LD_PRELOAD
    proot -0 --link2symlink -r "$CONTAINER_ROOT" -w /root \
        -b /dev/ -b /sys/ -b /proc/ \
        -b /data/data/com.termux/files/home \
        /usr/bin/env -i HOME=/root TERM="xterm-256color" \
        PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash
}
