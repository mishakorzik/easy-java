            BASENAME=$(basename "$MANIFEST")
            OWNER="${BASENAME%.tools}"
            OWNER="${OWNER%.system-commands}"
            OWNERS+=("$OWNER")
        done
        if [ ${#OWNERS[@]} -gt 0 ]; then
            mapfile -t OWNERS < <(printf '%s\n' "${OWNERS[@]}" | awk 'NF && !seen[$0]++')
            for OWNER in "${OWNERS[@]}"; do
