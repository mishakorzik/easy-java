java_menu() {
    while true; do
        echo -e ""
        echo -e "\033[01;33mJava (${SYSTEM_ARCH}):\033[0m"
        if [ ${#JAVA_NAMES[@]} -eq 0 ]; then
            echo -e "\033[01;31mNo Java versions found in versions.json\033[0m"
        fi
        for i in "${!JAVA_NAMES[@]}"; do
            local NAME="${JAVA_NAMES[$i]}"
            local RESOLVED
            RESOLVED=$(resolve_url "${JAVA_URLS[$i]}")
            local STATUS=""
            if [ -n "$RESOLVED" ]; then
                is_java_installed "$NAME" && STATUS=" \033[01;32m[installed]\033[0m"
                printf "\033[01;34m%02d\033[0m. %s%b\n" "$((i+1))" "$NAME" "$STATUS"
            else
                printf "\033[01;34m%02d\033[0m. %s \033[01;31m[unavailable]\033[0m\n" "$((i+1))" "$NAME"
            fi
        done
        printf "\033[01;34m00\033[0m. Back\n"
        read_menu_choice choice
        local MAX="${#JAVA_NAMES[@]}"
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$MAX" ]; then
            local NAME="${JAVA_NAMES[$((choice-1))]}"
            local RAW_URL="${JAVA_URLS[$((choice-1))]}"
            local RESOLVED
            RESOLVED=$(resolve_url "$RAW_URL")
            if [ -z "$RESOLVED" ]; then
                echo -e "\033[01;31m${NAME} is not available for ${SYSTEM_ARCH} architecture\033[0m"
                continue
            fi
            echo -e ""
            if is_java_installed "$NAME"; then
                echo -e "\033[01;34m01\033[0m. Reinstall ${NAME}"
                echo -e "\033[01;34m02\033[0m. Delete ${NAME}"
                echo -e "\033[01;34m03\033[0m. Re-add commands"
                echo -e "\033[01;34m00\033[0m. Back"
                read_menu_choice sub
                case "$sub" in
                    1) if do_install_java "$NAME" "$RAW_URL"; then remove_java_own_integration "$NAME"; prompt_java_integration "$NAME"; fi ;;
                    2) do_remove_java "$NAME" ;;
                    3) remove_java_own_integration "$NAME"; prompt_java_integration "$NAME" ;;
                esac
            else
                echo -e "\033[01;34m01\033[0m. Download ${NAME}"
                echo -e "\033[01;34m00\033[0m. Back"
                read_menu_choice sub
                if [ "$sub" = "1" ]; then
                    if do_install_java "$NAME" "$RAW_URL"; then
                        prompt_java_integration "$NAME"
                    fi
                fi
            fi
        elif [ "$choice" = "0" ]; then
            break
        else
            echo "Invalid option"
        fi
    done
}
generic_menu() {
    local CATEGORY="$1"
    local SLUG="$2"
    local -n NAMES_REF="NAMES_${SLUG}"
    local -n URLS_REF="URLS_${SLUG}"
    if ! has_installed_java; then
        if ! is_category_installed "$SLUG"; then
            require_installed_java "$CATEGORY" "install"
            return
        fi
        echo -e "\033[01;33m${CATEGORY} is installed, but no Java version is installed. It cannot run until Java is installed; deletion remains available.\033[0m"
    fi
    while true; do
        echo -e ""
        echo -e "\033[01;33m${CATEGORY}:\033[0m"
        if [ ${#NAMES_REF[@]} -eq 0 ]; then
            echo -e "\033[01;31mNo ${CATEGORY} versions found in versions.json\033[0m"
        fi
        local VER_INSTALLED
        VER_INSTALLED=$(get_category_version "$SLUG")
        for i in "${!NAMES_REF[@]}"; do
            local ENAME="${NAMES_REF[$i]}"
            local RESOLVED
            RESOLVED=$(resolve_url "${URLS_REF[$i]}")
            local STATUS=""
            if [ -n "$RESOLVED" ]; then
                [ "$ENAME" = "$VER_INSTALLED" ] && STATUS=" \033[01;32m[installed]\033[0m"
                printf "\033[01;34m%02d\033[0m. %s%b\n" "$((i+1))" "$ENAME" "$STATUS"
            else
                printf "\033[01;34m%02d\033[0m. %s \033[01;31m[unavailable]\033[0m\n" "$((i+1))" "$ENAME"
            fi
        done
        local NEXT=$((${#NAMES_REF[@]}+1))
        printf "\033[01;34m%02d\033[0m. Manage commands\n" "$NEXT"
        printf "\033[01;34m00\033[0m. Back\n"
        read_menu_choice choice
        local MAX="${#NAMES_REF[@]}"
        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$MAX" ]; then
            local ENAME="${NAMES_REF[$((choice-1))]}"
            local RAW_URL="${URLS_REF[$((choice-1))]}"
            local RESOLVED
            RESOLVED=$(resolve_url "$RAW_URL")
            if [ -z "$RESOLVED" ]; then
                echo -e "\033[01;31m${ENAME} is not available for ${SYSTEM_ARCH} architecture\033[0m"
                continue
            fi
            echo -e ""
            if [ "$ENAME" = "$VER_INSTALLED" ]; then
                if has_installed_java; then
                    echo -e "\033[01;34m01\033[0m. Reinstall ${ENAME}"
                    echo -e "\033[01;34m02\033[0m. Delete ${ENAME}"
                    echo -e "\033[01;34m03\033[0m. Re-add commands"
                    echo -e "\033[01;34m00\033[0m. Back"
                    read_menu_choice sub
                    case "$sub" in
                        1) if do_install_category "$CATEGORY" "$SLUG" "$ENAME" "$RAW_URL"; then remove_all_category_integrations "$SLUG"; prompt_category_java_link "$CATEGORY" "$SLUG"; fi ;;
                        2) do_remove_category "$CATEGORY" "$SLUG" ;;
                        3) remove_all_category_integrations "$SLUG"; prompt_category_java_link "$CATEGORY" "$SLUG" ;;
                    esac
                else
                    echo -e "\033[01;31m${CATEGORY} cannot run or be reinstalled because no Java version is installed.\033[0m"
                    echo -e "\033[01;34m02\033[0m. Delete ${ENAME}"
                    echo -e "\033[01;34m00\033[0m. Back"
                    read_menu_choice sub
                    [ "$sub" = "2" ] && do_remove_category "$CATEGORY" "$SLUG"
                fi
            else
                if ! has_installed_java; then
                    require_installed_java "$CATEGORY" "install"
                else
                    echo -e "\033[01;34m01\033[0m. Download ${ENAME}"
                    echo -e "\033[01;34m00\033[0m. Back"
                    read_menu_choice sub
                    [ "$sub" = "1" ] && { do_install_category "$CATEGORY" "$SLUG" "$ENAME" "$RAW_URL" && prompt_category_java_link "$CATEGORY" "$SLUG"; }
                fi
            fi
        elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -eq "$NEXT" ]; then
            if ! is_category_installed "$SLUG"; then
                echo "${CATEGORY} is not installed. Install ${CATEGORY} first."
            elif ! has_installed_java; then
                require_installed_java "$CATEGORY commands" "create"
            else
                prompt_category_java_link "$CATEGORY" "$SLUG"
            fi
        elif [ "$choice" = "0" ]; then
            break
        else
            echo "Invalid option"
        fi
    done
}
manual_launch() {
    ensure_container || return 1
    echo -e "Launching \033[01;34mproot shell\033[0m..."
    unset LD_PRELOAD
    proot -0 --link2symlink -r "$CONTAINER_ROOT" -w /root \
        -b /dev/ -b /sys/ -b /proc/ \
        -b "$HOME" \
        /usr/bin/env -i HOME=/root TERM="xterm-256color" \
        PATH=/bin:/usr/bin:/sbin:/usr/sbin /bin/bash
}
while true; do
    echo -e ""
    echo -e "\033[01;33mv${VERSION}\033[0m"
    N=${#CATEGORY_NAMES[@]}
    for i in "${!CATEGORY_NAMES[@]}"; do
        printf "\033[01;34m%02d\033[0m. %s\n" "$((i+1))" "${CATEGORY_NAMES[$i]}"
    done
    if [ "$IS_TERMUX" = true ]; then
        printf "\033[01;34m%02d\033[0m. Manual\n" "$((N+1))"
    fi
    printf "\033[01;34m00\033[0m. Quit\n"
    read_menu_choice mode
    if [[ "$mode" =~ ^[0-9]+$ ]] && [ "$mode" -ge 1 ] && [ "$mode" -le "$N" ]; then
        SEL_CAT="${CATEGORY_NAMES[$((mode-1))]}"
        SEL_SLUG="${CATEGORY_SLUGS[$((mode-1))]}"
        if [ "$SEL_CAT" = "Java" ]; then
            java_menu
        else
            generic_menu "$SEL_CAT" "$SEL_SLUG"
        fi
    elif [ "$IS_TERMUX" = true ] && [[ "$mode" =~ ^[0-9]+$ ]] && [ "$mode" -eq "$((N+1))" ]; then
        manual_launch
        break
    elif [ "$mode" = "0" ]; then
        exit 0
    else
        echo "Invalid option"
    fi
done
