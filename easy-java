do_install_java() {
    local NAME="$1"
    local RAW_URL="$2"
    local RESOLVED
    RESOLVED=$(resolve_url "$RAW_URL")
    if [ -z "$RESOLVED" ]; then
        echo -e "\033[01;31m${NAME} is not available for ${SYSTEM_ARCH} architecture\033[0m"
        return 1
    fi
    local ID
    ID=$(java_id "$NAME")
    local JDK="jdk-${ID}"
    ensure_container || return 1
    echo "Downloading ${NAME}..."
    local TMPFILE
    TMPFILE=$(mktemp "${TMPDIR:-/tmp}/easy-java-${ID}.XXXXXX") || return 1
    if ! download_asset "$RESOLVED" "$TMPFILE" || [ ! -s "$TMPFILE" ]; then
        echo -e "\033[01;31mDownload failed\033[0m"
        rm -f "$TMPFILE"
        return 1
    fi
    echo "Installing ${NAME}..."
    if ! install_extract_targz "$TMPFILE" "$BASE_DIR/$JDK"; then
        echo -e "\033[01;31mInstallation failed while extracting the archive\033[0m"
        rm -f "$TMPFILE"
        return 1
    fi
    rm -f "$TMPFILE"
    if [ ! -x "$BASE_DIR/$JDK/bin/java" ]; then
        echo -e "\033[01;31mInstallation failed: bin/java was not found or is not executable\033[0m"
        return 1
    fi
    echo -e "${NAME} \033[01;32minstalled\033[0m to $BASE_DIR/$JDK"
}
do_remove_java() {
    local NAME="$1"
    local ID JDK
    ID=$(java_id "$NAME")
    JDK="jdk-${ID}"
    echo "Removing ${NAME}..."
    local CLEANUP_STATUS=0
    remove_java_own_integration "$NAME" || CLEANUP_STATUS=1
    remove_java_dependent_integrations "$ID" || CLEANUP_STATUS=1
    if [ "$CLEANUP_STATUS" -ne 0 ]; then
        echo -e "\033[01;31mCould not remove all commands linked to ${NAME}; the JDK was not deleted.\033[0m"
        return 1
    fi
    if [ "$IS_TERMUX" = false ]; then
        run_as_root rm -rf "${BASE_DIR:?}/$JDK" || return 1
    else
        rm -rf "${BASE_DIR:?}/$JDK" || return 1
    fi
