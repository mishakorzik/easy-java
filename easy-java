#!/usr/bin/bash

VERSION="2.0.5"
check_update() {
    local REMOTE NEWEST
    REMOTE=$(wget -qO- "https://raw.githubusercontent.com/mishakorzik/easy-java/refs/heads/main/version.txt" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$REMOTE" ]; then
        echo -e "\033[01;33mCould not check for updates (no internet or URL unavailable).\033[0m"
        return
    fi
    if [ "$REMOTE" = "$VERSION" ]; then
        return
    fi
    NEWEST=$(printf '%s\n' "$VERSION" "$REMOTE" | sort -V | tail -n 1)
    if [ "$NEWEST" = "$REMOTE" ]; then
        echo -e "\033[01;31mA new version is available: ${REMOTE} (you have ${VERSION}).\033[0m"
        echo -e "\033[01;33mUpdate from: https://github.com/mishakorzik/easy-java\033[0m"
        exit 1
    else
        echo -e "\033[01;33mThis installed build is newer than the repository version. Continuing with ${VERSION}.\033[0m"
    fi
}
if [ -d "$PREFIX" ] && [ "$PREFIX" = "/data/data/com.termux/files/usr" ]; then
    IS_TERMUX=true
    BASE_DIR="/data/data/com.termux/files/java/usr/local"
    CONTAINER_ROOT="/data/data/com.termux/files/java"
else
    IS_TERMUX=false
    BASE_DIR="/usr/local"
    CONTAINER_ROOT=""
fi
ARCH=$(uname -m)
if [ "$ARCH" = "aarch64" ]; then
    SYSTEM_ARCH="arm64"
    DEBIAN_ARCH="arm64"
elif [ "$ARCH" = "x86_64" ] || [ "$ARCH" = "amd64" ]; then
    SYSTEM_ARCH="x86_64"
    DEBIAN_ARCH="amd64"
else
    echo "Unsupported architecture: $ARCH"
    echo "Supported architectures: aarch64, x86_64, amd64"
    exit 1
fi
if [ "$IS_TERMUX" = false ]; then
    if ! grep -q "ID=debian" /etc/os-release && ! grep -q "ID=ubuntu" /etc/os-release; then
        echo "This system is not supported. Supported systems: debian, ubuntu, termux."
        exit 1
    fi
fi
run_as_root() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo "$@"
    else
        echo -e "\033[01;31mAdministrator privileges are required, but sudo is not installed.\033[0m" >&2
        return 1
    fi
}
ensure_command_package() {
    local COMMAND_NAME="$1"
    local PACKAGE_NAME="$2"
    if command -v "$COMMAND_NAME" >/dev/null 2>&1; then
        echo -e "${COMMAND_NAME} is \033[01;32minstalled\033[0m"
        return 0
    fi

    echo -e "${COMMAND_NAME} is \033[01;31mnot\033[0m installed"
    if [ "$IS_TERMUX" = true ]; then
        pkg install "$PACKAGE_NAME" -y || return 1
    else
        run_as_root apt install "$PACKAGE_NAME" -y || return 1
    fi
    command -v "$COMMAND_NAME" >/dev/null 2>&1
}

if [ "$IS_TERMUX" = true ]; then
    ensure_command_package proot proot || exit 1
    ensure_command_package debootstrap debootstrap || exit 1
fi
ensure_command_package tar tar || exit 1
ensure_command_package wget wget || exit 1
ensure_command_package unzip unzip || exit 1
ensure_command_package jq jq || exit 1
check_update
JSON_DATA=$(wget -qO- "https://raw.githubusercontent.com/mishakorzik/easy-java/refs/heads/main/versions.json")
if [ -z "$JSON_DATA" ] || ! jq -e . <<< "$JSON_DATA" >/dev/null 2>&1; then
    echo -e "\033[01;31mCould not download or parse versions.json from \"https://raw.githubusercontent.com/mishakorzik/easy-java/refs/heads/main/versions.json\"\033[0m"
    exit 1
fi
sanitize_key() {
    printf '%s' "$1" | sed -E 's/[^A-Za-z0-9._-]+/-/g; s/^-+//; s/-+$//'
}
slugify() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '_' | sed -E 's/_+/_/g; s/^_+//; s/_+$//'
}
escape_regex() {
    printf '%s' "$1" | sed -e 's/[][\.*^$/]/\\&/g'
}
java_id() {
    local n
    n=$(printf '%s' "$1" | sed -E 's/^[Jj][Aa][Vv][Aa][[:space:]]+//')
    sanitize_key "$n"
}
normalize_menu_choice() {
    local VALUE="$1"
    [[ "$VALUE" =~ ^[0-9]+$ ]] || return 1
    while [ "${VALUE#0}" != "$VALUE" ]; do
        VALUE="${VALUE#0}"
    done
    [ -n "$VALUE" ] || VALUE=0
    printf '%s\n' "$VALUE"
}
read_menu_choice() {
    local __RESULT_VAR="$1"
    local PROMPT_TEXT="${2:-Choose: }"
    local RAW NORMALIZED
    read -r -p "$PROMPT_TEXT" RAW
    if NORMALIZED=$(normalize_menu_choice "$RAW"); then
        printf -v "$__RESULT_VAR" '%s' "$NORMALIZED"
    else
        printf -v "$__RESULT_VAR" '%s' ''
    fi
}
CATEGORY_NAMES=()
CATEGORY_SLUGS=()
while IFS= read -r cat; do
    [ -z "$cat" ] && continue
    CATEGORY_NAMES+=("$cat")
    slug=$(slugify "$cat")
    [ -z "$slug" ] && slug="cat${#CATEGORY_NAMES[@]}"
    CATEGORY_SLUGS+=("$slug")
done < <(jq -r 'keys_unsorted[]' <<< "$JSON_DATA" 2>/dev/null)
JAVA_NAMES=()
JAVA_URLS=()
for cat_idx in "${!CATEGORY_NAMES[@]}"; do
    [ "${CATEGORY_NAMES[$cat_idx]}" = "Java" ] && continue
    declare -ga "NAMES_${CATEGORY_SLUGS[$cat_idx]}=()"
    declare -ga "URLS_${CATEGORY_SLUGS[$cat_idx]}=()"
done
unset cat_idx
append_entry() {
    local slug="$1"
    local name="$2"
    local url="$3"
    local -n n_ref="NAMES_${slug}"
    local -n u_ref="URLS_${slug}"
    n_ref+=("$name")
    u_ref+=("$url")
}
load_versions() {
    local cat name url slug
    while IFS=$'\t' read -r cat name url; do
        [ -z "$cat" ] && continue
        if [ "$cat" = "Java" ]; then
            JAVA_NAMES+=("$name")
            JAVA_URLS+=("$url")
        else
            slug=$(slugify "$cat")
            [ -z "$slug" ] && continue
            append_entry "$slug" "$name" "$url"
        fi
    done < <(jq -r 'to_entries[] as $e | $e.value[] | [$e.key, .name, (.url|tojson)] | @tsv' <<< "$JSON_DATA" 2>/dev/null)
}
load_versions
resolve_url() {
    local raw="$1"
    local t
    t=$(printf '%s' "$raw" | jq -r 'type' 2>/dev/null)
    if [ "$t" = "object" ]; then
        printf '%s' "$raw" | jq -r --arg a "$SYSTEM_ARCH" '.[$a] // empty' 2>/dev/null
    elif [ "$t" = "string" ]; then
        printf '%s' "$raw" | jq -r '.' 2>/dev/null
    fi
}
is_direct_url() {
    [[ "$1" =~ ^https?:// ]]
}
ensure_gdown() {
    command -v gdown >/dev/null 2>&1 && return 0
    echo -e "gdown is \033[01;31mnot\033[0m installed; installing it for this Google Drive download..."
    if ! command -v python3 >/dev/null 2>&1; then
        if [ "$IS_TERMUX" = true ]; then
            pkg install python -y || return 1
        else
            run_as_root apt install python3 python3-pip -y || return 1
        fi
    fi
    if [ "$IS_TERMUX" = true ]; then
        python3 -m pip install gdown --break-system-packages
    else
        run_as_root python3 -m pip install gdown --break-system-packages
    fi
}

download_asset() {
    local raw_url="$1"
    local out="$2"
    if is_direct_url "$raw_url"; then
        wget "$raw_url" -O "$out"
    else
        ensure_gdown || return 1
        gdown "https://drive.google.com/uc?id=${raw_url}" -O "$out"
    fi
}
detect_archive_type() {
    local f="$1"
    local head
    head=$(head -c 4 "$f" 2>/dev/null | od -An -tx1 | tr -d ' \n')
    case "$head" in
        504b0304|504b0506|504b0708) echo "zip" ;;
        1f8b*) echo "targz" ;;
        *) echo "unknown" ;;
    esac
}
install_extracted_tree() {
    local ARCHIVE="$1"
    local TARGET="$2"
    local TYPE="$3"
    local TMP SRC STATUS

    TMP=$(mktemp -d) || return 1
    case "$TYPE" in
        targz) tar -xzf "$ARCHIVE" -C "$TMP" || { rm -rf "$TMP"; return 1; } ;;
        zip) unzip -q "$ARCHIVE" -d "$TMP" || { rm -rf "$TMP"; return 1; } ;;
        *) rm -rf "$TMP"; return 1 ;;
    esac

    local ENTRIES=()
    shopt -s nullglob dotglob
    ENTRIES=("$TMP"/*)
    shopt -u nullglob dotglob
    [ ${#ENTRIES[@]} -gt 0 ] || { rm -rf "$TMP"; return 1; }

    SRC="$TMP"
    if [ ${#ENTRIES[@]} -eq 1 ] && [ -d "${ENTRIES[0]}" ]; then
        SRC="${ENTRIES[0]}"
    fi

    STATUS=0
    if [ "$IS_TERMUX" = false ]; then
        if run_as_root rm -rf "${TARGET:?}" &&
           run_as_root mkdir -p "$TARGET" &&
           run_as_root cp -a "$SRC"/. "$TARGET"/; then
            :
        else
            STATUS=1
        fi
    else
        if rm -rf "${TARGET:?}" &&
           mkdir -p "$TARGET" &&
           cp -a "$SRC"/. "$TARGET"/; then
            :
        else
            STATUS=1
        fi
    fi
    rm -rf "$TMP"
    return "$STATUS"
}

install_extract_targz() {
    install_extracted_tree "$1" "$2" targz
}

install_extract_zip() {
    install_extracted_tree "$1" "$2" zip
}

install_extract_auto() {
    local FILE="$1"
    local TARGET="$2"
    local TYPE
    TYPE=$(detect_archive_type "$FILE")
    case "$TYPE" in
        zip|targz) install_extracted_tree "$FILE" "$TARGET" "$TYPE" ;;
        *) echo -e "\033[01;31mUnknown archive format\033[0m"; return 1 ;;
    esac
}

get_rc_file() {
    if [ -d "$HOME/.oh-my-zsh" ]; then
        echo "$HOME/.zshrc"
    elif [ "$IS_TERMUX" = true ]; then
        echo "$PREFIX/etc/bash.bashrc"
    else
        echo "$HOME/.bashrc"
    fi
}
is_java_installed() {
    [ -x "$BASE_DIR/jdk-$(java_id "$1")/bin/java" ]
}
get_installed_java_names() {
    local i NAME ID DIR
    local -A SEEN=()
    # Prefer the names from versions.json, but do not lose already installed
    # JDKs when a version is removed or renamed in the remote file.
    for i in "${!JAVA_NAMES[@]}"; do
        NAME="${JAVA_NAMES[$i]}"
        if is_java_installed "$NAME"; then
            ID=$(java_id "$NAME")
            SEEN["$ID"]=1
            printf '%s\n' "$NAME"
        fi
    done
    for DIR in "$BASE_DIR"/jdk-*; do
        [ -d "$DIR" ] || continue
        [ -x "$DIR/bin/java" ] || continue
        ID="${DIR##*/jdk-}"
        [ -n "$ID" ] || continue
        [ -n "${SEEN[$ID]+x}" ] && continue
        printf 'Java %s\n' "$ID"
    done
}
has_installed_java() {
    [ -n "$(get_installed_java_names | head -n 1)" ]
}
require_installed_java() {
    local CATEGORY="$1"
    local ACTION="${2:-install}"
    if has_installed_java; then
        return 0
    fi
    echo -e "\033[01;31mCannot ${ACTION} ${CATEGORY}: no Java version is installed. Install Java first.\033[0m"
    return 1
}
is_category_installed() { [ -d "$BASE_DIR/$1/bin" ] && [ -n "$(get_bin_tools "$1" | head -n 1)" ]; }
get_category_version() { [ -f "$BASE_DIR/$1/.version" ] && cat "$BASE_DIR/$1/.version" || echo ""; }
get_bin_tools() {
    local dir="$1"
    local bin="$BASE_DIR/${dir}/bin"
    [ -d "$bin" ] || return
    local f
    for f in "$bin"/*; do
        [ -f "$f" ] && [ -x "$f" ] && printf '%s\n' "$(basename "$f")"
    done
}
container_layout_is_valid() {
    [ -x "$CONTAINER_ROOT/bin/bash" ] &&
        [ -f "$CONTAINER_ROOT/etc/os-release" ] &&
        grep -q "ID=debian" "$CONTAINER_ROOT/etc/os-release" 2>/dev/null
}
ensure_container() {
    [ "$IS_TERMUX" = false ] && return
    if [ -d "$CONTAINER_ROOT" ]; then
        if container_layout_is_valid; then
            echo "Skipping Debian container install (already exists)"
            return
        fi
        echo -e "\033[01;33mThe existing Debian container is incomplete; rebuilding it.\033[0m"
        rm -rf "${CONTAINER_ROOT:?}" || return 1
    fi

    echo "Installing Debian container (this will take a while)..."
    if ! debootstrap --variant=minbase --arch="$DEBIAN_ARCH" --components=main stable \
        "$CONTAINER_ROOT" http://ftp.debian.org/debian/ > /dev/null 2>&1; then
        rm -rf "${CONTAINER_ROOT:?}"
        echo -e "\033[01;31mFailed to install Debian container\033[0m"
        return 1
    fi

    echo "Verifying Debian container..."
    unset LD_PRELOAD
    local PROOT_ARGS=(
        -0 --link2symlink -r "$CONTAINER_ROOT" -w /root
        -b /dev/ -b /sys/ -b /proc/ -b "$HOME"
    )
    if proot "${PROOT_ARGS[@]}" /usr/bin/env -i HOME=/root \
        TERM="xterm-256color" PATH=/bin:/usr/bin:/sbin:/usr/sbin \
        grep -q "ID=debian" /etc/os-release; then
        echo -e "Debian container \033[01;32minstalled\033[0m"
    else
        rm -rf "${CONTAINER_ROOT:?}"
        echo -e "\033[01;31mFailed to verify Debian container\033[0m"
        return 1
    fi
}
# Shell commands are stored in the user's rc file. System commands are simple
# executable scripts in /usr/bin on Debian/Ubuntu. Termux uses $PREFIX/bin
# because Android does not provide a writable host /usr/bin directory.
INTEGRATION_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/easy-java/integrations"
if [ "$IS_TERMUX" = true ]; then
    WRAPPER_DIR="$PREFIX/bin"
else
    WRAPPER_DIR="/usr/bin"
fi
integration_manifest_path() {
    local OWNER
    OWNER=$(sanitize_key "$1")
    printf '%s/%s.tools' "$INTEGRATION_DIR" "$OWNER"
}
integration_wrapper_manifest_path() {
    local OWNER
    OWNER=$(sanitize_key "$1")
    printf '%s/%s.system-commands' "$INTEGRATION_DIR" "$OWNER"
}
integration_owner_java() {
    printf 'java-%s' "$1"
}

integration_owner_category() {
    printf '%s-java-%s' "$1" "$2"
}

is_supported_tool_name() {
    [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ ]]
}
all_rc_files() {
    local FILES=("$(get_rc_file)" "$HOME/.bashrc" "$HOME/.zshrc")
    if [ "$IS_TERMUX" = true ]; then
        FILES+=("$PREFIX/etc/bash.bashrc" "$CONTAINER_ROOT/root/.bashrc")
    fi
    printf '%s\n' "${FILES[@]}" | awk 'NF && !seen[$0]++'
}
remove_managed_rc_block() {
    local OWNER="$1"
    local BEGIN_MARKER="# >>> easy-java:${OWNER} >>>"
    local END_MARKER="# <<< easy-java:${OWNER} <<<"
    local RC TMP
    local STATUS=0
    while IFS= read -r RC; do
        [ -f "$RC" ] || continue
        grep -Fqx "$BEGIN_MARKER" "$RC" 2>/dev/null || continue
        TMP=$(mktemp) || { STATUS=1; continue; }
        if ! awk -v begin="$BEGIN_MARKER" -v end="$END_MARKER" '
            $0 == begin { skip=1; next }
            $0 == end { skip=0; next }
            !skip { print }
        ' "$RC" > "$TMP" || ! cat "$TMP" > "$RC"; then
            STATUS=1
        fi
        rm -f "$TMP"
    done < <(all_rc_files)
    return "$STATUS"
}
remove_legacy_command_from_rc() {
    local COMMAND_NAME="$1"
    local ESCAPED RC
    local STATUS=0
    ESCAPED=$(escape_regex "$COMMAND_NAME")
    while IFS= read -r RC; do
        [ -f "$RC" ] || continue
        if grep -Eq "^[[:space:]]*(${ESCAPED}\(\)[[:space:]]*\{|alias[[:space:]]+${ESCAPED}=)" "$RC" 2>/dev/null; then
            sed -i "/^[[:space:]]*${ESCAPED}()[[:space:]]*{/,/^[[:space:]]*}/d" "$RC" 2>/dev/null || STATUS=1
            sed -i "/^[[:space:]]*alias[[:space:]]\+${ESCAPED}=/d" "$RC" 2>/dev/null || STATUS=1
        fi
    done < <(all_rc_files)
    return "$STATUS"
}
remove_file_with_privileges() {
    local PATHNAME="$1"
    [ -e "$PATHNAME" ] || [ -L "$PATHNAME" ] || return 0
    if [ "$IS_TERMUX" = true ]; then
        rm -f "$PATHNAME"
    else
        run_as_root rm -f "$PATHNAME"
    fi
}
system_command_dirs() {
    local DIRS=("$WRAPPER_DIR" "/usr/bin" "/usr/local/bin")
    if [ "$IS_TERMUX" = true ]; then
        DIRS+=("$PREFIX/bin")
    fi
    printf '%s\n' "${DIRS[@]}" | awk 'NF && !seen[$0]++'
}

integration_owner_java_id() {
    local OWNER="$1"
    case "$OWNER" in
        java-*) printf '%s\n' "${OWNER#java-}" ;;
        *-java-*) printf '%s\n' "${OWNER##*-java-}" ;;
        *) return 1 ;;
    esac
}
remove_system_command_if_owned() {
    local OWNER="$1"
    local COMMAND_NAME="$2"
    local MANIFEST JAVA_ID DIR PATHNAME OWNED
    local STATUS=0
    MANIFEST=$(integration_wrapper_manifest_path "$OWNER")
    JAVA_ID=$(integration_owner_java_id "$OWNER" 2>/dev/null || true)
    while IFS= read -r DIR; do
        PATHNAME="$DIR/$COMMAND_NAME"
        [ -f "$PATHNAME" ] || [ -L "$PATHNAME" ] || continue
        OWNED=false
        if [ -f "$MANIFEST" ] && grep -Fqx "$COMMAND_NAME" "$MANIFEST" 2>/dev/null; then
            OWNED=true
        elif grep -Fqx "# easy-java-owner: ${OWNER}" "$PATHNAME" 2>/dev/null; then
            OWNED=true
        elif [ -n "$JAVA_ID" ] &&
             { grep -Fq "jdk-${JAVA_ID}" "$PATHNAME" 2>/dev/null ||
               grep -Fq "java-${JAVA_ID};" "$PATHNAME" 2>/dev/null; }; then
            OWNED=true
        fi
        if [ "$OWNED" = true ]; then
            remove_file_with_privileges "$PATHNAME" || STATUS=1
        fi
    done < <(system_command_dirs)
    return "$STATUS"
}
remove_integration_owner() {
    local OWNER="$1"
    shift
    local MANIFEST WRAPPER_MANIFEST ITEM
    local STATUS=0
    local COMMANDS=("$@")
    MANIFEST=$(integration_manifest_path "$OWNER")
    WRAPPER_MANIFEST=$(integration_wrapper_manifest_path "$OWNER")
    if [ -f "$MANIFEST" ]; then
        while IFS= read -r ITEM; do
            [ -n "$ITEM" ] && COMMANDS+=("$ITEM")
        done < "$MANIFEST"
    fi
    if [ -f "$WRAPPER_MANIFEST" ]; then
        while IFS= read -r ITEM; do
            [ -n "$ITEM" ] && COMMANDS+=("$ITEM")
        done < "$WRAPPER_MANIFEST"
    fi
    remove_managed_rc_block "$OWNER" || STATUS=1
    if [ ${#COMMANDS[@]} -gt 0 ]; then
        mapfile -t COMMANDS < <(printf '%s\n' "${COMMANDS[@]}" | awk 'NF && !seen[$0]++')
        for ITEM in "${COMMANDS[@]}"; do
            remove_legacy_command_from_rc "$ITEM" || STATUS=1
            remove_system_command_if_owned "$OWNER" "$ITEM" || STATUS=1
        done
    fi
    if [ "$STATUS" -eq 0 ]; then
        rm -f "$MANIFEST" "$WRAPPER_MANIFEST" || STATUS=1
    fi
    return "$STATUS"
}
# Remove integrations by their embedded Java reference, even when a category
# was renamed in versions.json or an older easy-java release left no manifest.
remove_managed_rc_blocks_for_java() {
    local JAVA_ID="$1"
    local RC TMP
    local STATUS=0
    while IFS= read -r RC; do
        [ -f "$RC" ] || continue
        grep -Fq "java-${JAVA_ID}" "$RC" 2>/dev/null || continue
        TMP=$(mktemp) || { STATUS=1; continue; }
        if ! awk -v id="$JAVA_ID" '
            function ends_with(value, suffix) {
                return length(value) >= length(suffix) && \
                    substr(value, length(value) - length(suffix) + 1) == suffix
            }
            /^# >>> easy-java:/ {
                owner=$0
                sub(/^# >>> easy-java:/, "", owner)
                sub(/ >>>$/, "", owner)
                if (owner == "java-" id || ends_with(owner, "-java-" id)) {
                    skipped_owner=owner
                    skip=1
                    next
                }
            }
            skip && $0 == "# <<< easy-java:" skipped_owner " <<<" {
                skip=0
                skipped_owner=""
                next
            }
            !skip { print }
        ' "$RC" > "$TMP" || ! cat "$TMP" > "$RC"; then
            STATUS=1
        fi
        rm -f "$TMP"
    done < <(all_rc_files)
    return "$STATUS"
}
remove_legacy_java_entries_from_rc() {
    local JAVA_ID="$1"
    local RC TMP
    local STATUS=0
    while IFS= read -r RC; do
        [ -f "$RC" ] || continue
        grep -Fq "${JAVA_ID}" "$RC" 2>/dev/null || continue
        TMP=$(mktemp) || { STATUS=1; continue; }
        if ! awk -v id="$JAVA_ID" '
            function trim(value) {
                sub(/^[[:space:]]+/, "", value)
                sub(/[[:space:]]+$/, "", value)
                return value
            }
            function ends_with(value, suffix) {
                return length(value) >= length(suffix) && \
                    substr(value, length(value) - length(suffix) + 1) == suffix
            }
            function linked(value) {
                return index(value, "jdk-" id) || index(value, "java-" id)
            }
            function generated(value) {
                return index(value, "JAVA_HOME") || index(value, "proot ") || \
                    index(value, "LD_PRELOAD") || index(value, "/usr/bin/env -i") || \
                    index(value, "easy-java")
            }
            function flush_function() {
                if (!(linked(function_text) && generated(function_text))) {
                    printf "%s", function_text
                }
                in_function=0
                function_text=""
            }
            {
                line=$0
                if (in_function) {
                    function_text=function_text line ORS
                    if (line ~ /^[[:space:]]*}[[:space:]]*$/) {
                        flush_function()
                    }
                    next
                }
                if (line ~ /^[[:space:]]*alias[[:space:]]+[^=]+=/) {
                    alias_name=line
                    sub(/^[[:space:]]*alias[[:space:]]+/, "", alias_name)
                    sub(/=.*/, "", alias_name)
                    alias_name=trim(alias_name)
                    if (ends_with(alias_name, "-" id) && linked(line) && generated(line)) {
                        next
                    }
                }
                if (line ~ /\(\)[[:space:]]*\{[[:space:]]*$/) {
                    function_name=line
                    sub(/\(\).*/, "", function_name)
                    function_name=trim(function_name)
                    if (ends_with(function_name, "-" id)) {
                        in_function=1
                        function_text=line ORS
                        next
                    }
                }
                print line
            }
            END {
                if (in_function) {
                    flush_function()
                }
            }
        ' "$RC" > "$TMP" || ! cat "$TMP" > "$RC"; then
            STATUS=1
        fi
        rm -f "$TMP"
    done < <(all_rc_files)
    return "$STATUS"
}
remove_java_linked_system_commands() {
    local JAVA_ID="$1"
    local DIR PATHNAME
    local STATUS=0
    while IFS= read -r DIR; do
        [ -d "$DIR" ] || continue
        while IFS= read -r -d '' PATHNAME; do
            [ -f "$PATHNAME" ] || [ -L "$PATHNAME" ] || continue
            if { grep -Fq "jdk-${JAVA_ID}" "$PATHNAME" 2>/dev/null ||
                 grep -Fq "java-${JAVA_ID};" "$PATHNAME" 2>/dev/null; } &&
               { grep -Fq "JAVA_HOME" "$PATHNAME" 2>/dev/null ||
                 grep -Fq "proot " "$PATHNAME" 2>/dev/null ||
                 grep -Fq "easy-java-owner:" "$PATHNAME" 2>/dev/null; }; then
                remove_file_with_privileges "$PATHNAME" || STATUS=1
            fi
        done < <(find "$DIR" -maxdepth 1 \( -type f -o -type l \) -name "*-${JAVA_ID}" -print0 2>/dev/null)
    done < <(system_command_dirs)
    return "$STATUS"
}
remove_manifest_integrations_for_java() {
